generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES_REP
  SALES_MANAGER
  FINANCE
  OPERATIONS
  CUSTOMER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  name         String
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  quotationsCreated QuotationVersion[] @relation("quotation_creator")
  auditLogs         AuditLog[]         @relation("audit_actor")
}

// ==========================================
// CONFIGURATION & PRODUCTS
// ==========================================

model CustomerTier {
  id             String           @id @default(uuid())
  name           String           @unique
  description    String?
  prices         ProductPricing[]
  discountRules  DiscountRule[]
}

model Product {
  id                String   @id @default(uuid())
  name              String
  category          String
  isSubscription    Boolean  @default(false)
  recurringInterval String?  // e.g. MONTHLY, QUARTERLY, YEARLY
  quantityOnHand    Int      @default(0)
  variantAttributes Json?    
  pricing           ProductPricing[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  inventory         Inventory[]
}

model ProductPricing {
  id             String        @id @default(uuid())
  productId      String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  customerTierId String?
  customerTier   CustomerTier? @relation(fields: [customerTierId], references: [id])
  price          Decimal       @db.Decimal(12, 2)
}

enum DiscountAppliedTo {
  TIER
  CATEGORY
}

model DiscountRule {
  id                    String            @id @default(uuid())
  appliedTo             DiscountAppliedTo 
  targetTierId          String?
  targetTier            CustomerTier?     @relation(fields: [targetTierId], references: [id])
  productCategory       String?
  maxDiscountPercentage Decimal           @db.Decimal(5, 2)
}

model ApprovalRule {
  id                    String @id @default(uuid())
  minRiskScore          Int
  maxRiskScore          Int
  requiredApproverLevel Role   
  priority              Int    @default(0)
}

// ==========================================
// QUOTATION & NEGOTIATION
// ==========================================

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  REJECTED
  NEGOTIATION
  SENT
  CONFIRMED
  CONVERTED
  CANCELLED
}

model Quotation {
  id              String             @id @default(uuid())
  quotationNumber String             @unique
  customerId      String             
  salesRepId      String             
  status          QuotationStatus    @default(DRAFT)
  activeVersionId String?            @unique
  versions        QuotationVersion[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  
  order           Order?
}

model QuotationVersion {
  id               String            @id @default(uuid())
  quotationId      String
  quotation        Quotation         @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  versionNumber    Int
  totalAmount      Decimal           @db.Decimal(12, 2)
  totalDiscount    Decimal           @db.Decimal(12, 2)
  riskScore        Int               @default(0)
  createdById      String
  createdBy        User              @relation("quotation_creator", fields: [createdById], references: [id])
  
  items            QuotationItem[]
  approvals        ApprovalRequest[]
  messages         NegotiationMessage[]
  
  createdAt        DateTime          @default(now())
  
  activeForQuotation Quotation?      @relation(name: "ActiveVersion", fields: [id], references: [activeVersionId])
}

model QuotationItem {
  id                 String           @id @default(uuid())
  quotationVersionId String
  quotationVersion   QuotationVersion @relation(fields: [quotationVersionId], references: [id], onDelete: Cascade)
  productId          String
  quantity           Int
  unitPrice          Decimal          @db.Decimal(12, 2)
  discountPercentage Decimal          @db.Decimal(5, 2)
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

model ApprovalRequest {
  id                 String           @id @default(uuid())
  quotationVersionId String
  quotationVersion   QuotationVersion @relation(fields: [quotationVersionId], references: [id])
  assignedRole       Role
  status             ApprovalStatus   @default(PENDING)
  actionedById       String?
  comments           String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model NegotiationMessage {
  id                 String           @id @default(uuid())
  quotationVersionId String
  quotationVersion   QuotationVersion @relation(fields: [quotationVersionId], references: [id])
  authorId           String
  content            String
  isCommercialChange Boolean          @default(false)
  createdAt          DateTime         @default(now())
}

// ==========================================
// INVENTORY & FULFILLMENT
// ==========================================

model Warehouse {
  id          String      @id @default(uuid())
  code        String      @unique
  name        String
  location    String?
  inventory   Inventory[]
  fulfillments FulfillmentItem[]
}

model Inventory {
  id                String      @id @default(uuid())
  warehouseId       String
  warehouse         Warehouse   @relation(fields: [warehouseId], references: [id])
  productId         String
  product           Product     @relation(fields: [productId], references: [id])
  availableQuantity Int         @default(0) 
  reservedQuantity  Int         @default(0)
  
  @@unique([warehouseId, productId])
}

enum FulfillmentMode {
  LOWEST_COST
  MIN_SHIPMENTS
  BALANCED
}

model FulfillmentPlan {
  id                String             @id @default(uuid())
  orderId           String             @unique
  order             Order              @relation(fields: [orderId], references: [id])
  optimizationMode  FulfillmentMode
  totalCost         Decimal            @db.Decimal(10, 2)
  shipmentCount     Int
  estimatedDelivery DateTime?
  items             FulfillmentItem[]
  createdAt         DateTime           @default(now())
}

enum FulfillmentStatus {
  PENDING
  SHIPPED
  DELIVERED
  BACKORDER
  CANCELLED
}

model FulfillmentItem {
  id                 String            @id @default(uuid())
  fulfillmentPlanId  String
  fulfillmentPlan    FulfillmentPlan   @relation(fields: [fulfillmentPlanId], references: [id])
  warehouseId        String?           // Null if backordered
  warehouse          Warehouse?        @relation(fields: [warehouseId], references: [id])
  productId          String
  quantity           Int
  status             FulfillmentStatus @default(PENDING)
  estimatedDelivery  DateTime?
}

// ==========================================
// ORDERS, INVOICES, SUBSCRIPTIONS
// ==========================================

enum OrderStatus {
  PROCESSING
  PARTIAL_FULFILLMENT
  FULFILLED
  CANCELLED
}

model Order {
  id             String        @id @default(uuid())
  orderNumber    String        @unique
  quotationId    String        @unique
  quotation      Quotation     @relation(fields: [quotationId], references: [id])
  customerId     String
  status         OrderStatus   @default(PROCESSING)
  totalAmount    Decimal       @db.Decimal(12, 2)
  
  items          OrderItem[]
  invoices       Invoice[]
  subscriptions  Subscription[]
  fulfillmentPlan FulfillmentPlan?
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model OrderItem {
  id                 String   @id @default(uuid())
  orderId            String
  order              Order    @relation(fields: [orderId], references: [id])
  productId          String
  snapshotName       String
  quantity           Int
  snapshotUnitPrice  Decimal  @db.Decimal(12, 2)
  snapshotDiscount   Decimal  @db.Decimal(5, 2)
  isSubscription     Boolean  @default(false)
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  customerId    String
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime
  totalAmount   Decimal       @db.Decimal(12, 2)
  payments      Payment[]
  createdAt     DateTime      @default(now())
}

model Payment {
  id            String   @id @default(uuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  amount        Decimal  @db.Decimal(12, 2)
  paymentMethod String
  reference     String?
  paidAt        DateTime @default(now())
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model Subscription {
  id              String             @id @default(uuid())
  orderId         String
  order           Order              @relation(fields: [orderId], references: [id])
  customerId      String
  interval        String             // MONTHLY, QUARTERLY, YEARLY
  status          SubscriptionStatus @default(ACTIVE)
  nextBillingDate DateTime
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

// ==========================================
// AUDIT & OUTBOX
// ==========================================

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String
  actor       User     @relation("audit_actor", fields: [actorId], references: [id])
  entityType  String   // e.g., 'QUOTATION', 'INVENTORY'
  entityId    String
  action      String   // e.g., 'STATUS_CHANGE'
  oldData     Json?
  newData     Json?
  timestamp   DateTime @default(now())
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

model OutboxEvent {
  id            String       @id @default(uuid())
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?
  createdAt     DateTime     @default(now())
  publishedAt   DateTime?
}
