generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  SALES_REP
  SALES_MANAGER
  FINANCE
  OPERATIONS
  CUSTOMER
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String?
  name         String
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  quotationsCreated QuotationVersion[] @relation("quotation_creator")
  auditLogs         AuditLog[]         @relation("audit_actor")
}

// ==========================================
// CONFIGURATION & PRODUCTS
// ==========================================

model CustomerTier {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  description    String?
  prices         ProductPricing[]
  discountRules  DiscountRule[]
}

model Product {
  id                Int              @id @default(autoincrement())
  name              String
  category          String
  isSubscription    Boolean          @default(false)
  recurringInterval String?          // e.g. MONTHLY, QUARTERLY, YEARLY
  quantityOnHand    Int              @default(0)
  variantAttributes Json?    
  pricing           ProductPricing[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  inventory         Inventory[]
}

model ProductPricing {
  id             Int           @id @default(autoincrement())
  productId      Int
  product        Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  customerTierId Int?
  customerTier   CustomerTier? @relation(fields: [customerTierId], references: [id])
  price          Decimal       @db.Decimal(12, 2)
}

enum DiscountAppliedTo {
  TIER
  CATEGORY
}

model DiscountRule {
  id                    Int               @id @default(autoincrement())
  appliedTo             DiscountAppliedTo 
  targetTierId          Int?
  targetTier            CustomerTier?     @relation(fields: [targetTierId], references: [id])
  productCategory       String?
  maxDiscountPercentage Decimal           @db.Decimal(5, 2)
}

model ApprovalRule {
  id                    Int  @id @default(autoincrement())
  minRiskScore          Int
  maxRiskScore          Int
  requiredApproverLevel Role   
  priority              Int  @default(0)
}

// ==========================================
// QUOTATION & NEGOTIATION
// ==========================================

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  NEGOTIATION
  SENT
  CONFIRMED
  CONVERTED
  CANCELLED
}

model Quotation {
  id              Int                @id @default(autoincrement())
  quotationNumber String             @unique
  customerId      Int             
  salesRepId      Int             
  status          QuotationStatus    @default(DRAFT)
  activeVersionId Int?               @unique
  activeVersion   QuotationVersion?  @relation(name: "ActiveVersion", fields: [activeVersionId], references: [id])
  versions        QuotationVersion[] @relation(name: "QuotationVersions")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  
  order           Order?
}

model QuotationVersion {
  id               Int               @id @default(autoincrement())
  quotationId      Int
  quotation        Quotation         @relation(name: "QuotationVersions", fields: [quotationId], references: [id], onDelete: Restrict)
  versionNumber    Int
  totalAmount      Decimal           @db.Decimal(12, 2)
  totalDiscount    Decimal           @db.Decimal(12, 2)
  riskScore        Int               @default(0)
  internalNotes    String?           // Internal notes (not visible to customer)
  createdById      Int?
  createdBy        User?             @relation("quotation_creator", fields: [createdById], references: [id], onDelete: SetNull)
  
  items            QuotationItem[]
  approvals        ApprovalRequest[]
  messages         NegotiationMessage[]
  
  createdAt        DateTime          @default(now())
  
  activeForQuotation Quotation?      @relation(name: "ActiveVersion")
}

model QuotationItem {
  id                 Int              @id @default(autoincrement())
  quotationVersionId Int
  quotationVersion   QuotationVersion @relation(fields: [quotationVersionId], references: [id], onDelete: Cascade)
  productId          Int
  quantity           Int
  unitPrice          Decimal          @db.Decimal(12, 2)
  discountPercentage Decimal          @db.Decimal(5, 2)
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

model ApprovalRequest {
  id                 Int              @id @default(autoincrement())
  quotationVersionId Int
  quotationVersion   QuotationVersion @relation(fields: [quotationVersionId], references: [id])
  assignedRole       Role
  status             ApprovalStatus   @default(PENDING)
  actionedById       Int?
  comments           String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model NegotiationMessage {
  id                 Int              @id @default(autoincrement())
  quotationVersionId Int
  quotationVersion   QuotationVersion @relation(fields: [quotationVersionId], references: [id])
  authorId           Int
  senderRole         String?          // SALES_REP, CUSTOMER, MANAGER etc.
  content            String
  proposedDiscount   Decimal?         @db.Decimal(5, 2)
  isCommercialChange Boolean          @default(false)
  createdAt          DateTime         @default(now())
}

// ==========================================
// INVENTORY & FULFILLMENT
// ==========================================

model Warehouse {
  id          Int               @id @default(autoincrement())
  code        String            @unique
  name        String
  location    String?
  inventory   Inventory[]
  fulfillments FulfillmentItem[]
}

model Inventory {
  id                Int         @id @default(autoincrement())
  warehouseId       Int
  warehouse         Warehouse   @relation(fields: [warehouseId], references: [id])
  productId         Int
  product           Product     @relation(fields: [productId], references: [id])
  availableQuantity Int         @default(0) 
  reservedQuantity  Int         @default(0)
  
  @@unique([warehouseId, productId])
}

enum FulfillmentMode {
  LOWEST_COST
  MIN_SHIPMENTS
  BALANCED
}

model FulfillmentPlan {
  id                Int                @id @default(autoincrement())
  orderId           Int                @unique
  order             Order              @relation(fields: [orderId], references: [id])
  optimizationMode  FulfillmentMode
  totalCost         Decimal            @db.Decimal(10, 2)
  shipmentCount     Int
  estimatedDelivery DateTime?
  items             FulfillmentItem[]
  createdAt         DateTime           @default(now())
}

enum FulfillmentStatus {
  PENDING
  SHIPPED
  DELIVERED
  BACKORDER
  CANCELLED
}

model FulfillmentItem {
  id                 Int               @id @default(autoincrement())
  fulfillmentPlanId  Int
  fulfillmentPlan    FulfillmentPlan   @relation(fields: [fulfillmentPlanId], references: [id])
  warehouseId        Int?              // Null if backordered
  warehouse          Warehouse?        @relation(fields: [warehouseId], references: [id])
  productId          Int
  quantity           Int
  status             FulfillmentStatus @default(PENDING)
  estimatedDelivery  DateTime?
}

// ==========================================
// ORDERS, INVOICES, SUBSCRIPTIONS
// ==========================================

enum OrderStatus {
  PROCESSING
  PARTIAL_FULFILLMENT
  FULFILLED
  CANCELLED
}

model Order {
  id             Int             @id @default(autoincrement())
  orderNumber    String          @unique
  quotationId    Int             @unique
  quotation      Quotation       @relation(fields: [quotationId], references: [id])
  customerId     Int
  status         OrderStatus     @default(PROCESSING)
  totalAmount    Decimal         @db.Decimal(12, 2)
  
  items          OrderItem[]
  invoices       Invoice[]
  subscriptions  Subscription[]
  fulfillmentPlan FulfillmentPlan?
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model OrderItem {
  id                 Int      @id @default(autoincrement())
  orderId            Int
  order              Order    @relation(fields: [orderId], references: [id])
  productId          Int
  snapshotName       String
  quantity           Int
  snapshotUnitPrice  Decimal  @db.Decimal(12, 2)
  snapshotDiscount   Decimal  @db.Decimal(5, 2)
  isSubscription     Boolean  @default(false)
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
}

model Invoice {
  id            Int           @id @default(autoincrement())
  invoiceNumber String        @unique
  orderId       Int
  order         Order         @relation(fields: [orderId], references: [id])
  customerId    Int
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime
  totalAmount   Decimal       @db.Decimal(12, 2)
  taxAmount     Decimal       @db.Decimal(12, 2) @default(0)
  payments      Payment[]
  createdAt     DateTime      @default(now())
}

model Payment {
  id            Int      @id @default(autoincrement())
  invoiceId     Int
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  amount        Decimal  @db.Decimal(12, 2)
  paymentMethod String
  reference     String?
  paidAt        DateTime @default(now())
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model Subscription {
  id              Int                @id @default(autoincrement())
  orderId         Int
  order           Order              @relation(fields: [orderId], references: [id])
  customerId      Int
  interval        String             // MONTHLY, QUARTERLY, YEARLY
  status          SubscriptionStatus @default(ACTIVE)
  nextBillingDate DateTime
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

// ==========================================
// AUDIT & OUTBOX
// ==========================================

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorId     Int?
  actor       User?    @relation("audit_actor", fields: [actorId], references: [id], onDelete: SetNull)
  entityType  String   // e.g., 'QUOTATION', 'INVENTORY'
  entityId    String
  action      String   // e.g., 'STATUS_CHANGE'
  oldData     Json?
  newData     Json?
  timestamp   DateTime @default(now())
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

model OutboxEvent {
  id            Int          @id @default(autoincrement())
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?
  createdAt     DateTime     @default(now())
  publishedAt   DateTime?
}
